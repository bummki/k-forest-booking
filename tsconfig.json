{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx"
    },
    "include": [
        "src",
        "App.tsx",
        "constants.tsx",
        "forestApi.ts",
        "index.tsx",
        "posts.ts",
        "types.ts",
        "vite-env.d.ts",
        "forest_data.js",
        "map_data.js"
    ],
    "exclude": [
        "node_modules",
        "vite.config.ts"
    ]
}
